pipeline {
    agent { label 'homelab-automation' }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(name: 'HOMELAB_INFISICAL_CREDENTIAL_ID', defaultValue: 'infisical-homelab-prod', description: 'Jenkins credential ID to assign to the read-only Infisical Universal Auth credential.')
        string(name: 'HOMELAB_INFISICAL_URL', defaultValue: 'https://app.infisical.com', description: 'Infisical server URL. HTTPS is required.')
        nonStoredPassword(name: 'HOMELAB_INFISICAL_PROJECT_ID', description: 'Infisical project UUID. It will be saved in Jenkins credentials for later pipelines.')
        string(name: 'HOMELAB_INFISICAL_ENVIRONMENT', defaultValue: 'prod', description: 'Infisical environment slug.')
        string(name: 'HOMELAB_INFISICAL_PROJECT_SLUG', defaultValue: '', description: 'Optional Infisical project slug.')
        string(name: 'INFISICAL_READ_CLIENT_ID', defaultValue: '', description: 'Client ID for the existing jenkins-read Machine Identity.')
        nonStoredPassword(name: 'INFISICAL_READ_CLIENT_SECRET', description: 'Client Secret for jenkins-read. This password parameter is not stored in the build record.')
        string(name: 'INFISICAL_WRITE_CLIENT_ID', defaultValue: '', description: 'Client ID for the existing jenkins-write Machine Identity.')
        nonStoredPassword(name: 'INFISICAL_WRITE_CLIENT_SECRET', description: 'Client Secret for jenkins-write. This password parameter is not stored in the build record.')
    }

    stages {
        stage('Validate and create credentials') {
            steps {
                script {
                    if (!(params.HOMELAB_INFISICAL_URL ==~ /^https:\/\/[^\s]+$/)) {
                        error('HOMELAB_INFISICAL_URL must be an HTTPS URL.')
                    }
                    if (!(params.HOMELAB_INFISICAL_PROJECT_ID ==~ /^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$/)) {
                        error('HOMELAB_INFISICAL_PROJECT_ID must be your Infisical project UUID.')
                    }
                    if (!(params.HOMELAB_INFISICAL_CREDENTIAL_ID ==~ /^[A-Za-z0-9][A-Za-z0-9_.-]{2,99}$/)) {
                        error('HOMELAB_INFISICAL_CREDENTIAL_ID must be a Jenkins credential ID (letters, digits, dot, underscore, hyphen).')
                    }
                    if (!params.HOMELAB_INFISICAL_ENVIRONMENT?.trim() || params.HOMELAB_INFISICAL_ENVIRONMENT.contains('/')) {
                        error('HOMELAB_INFISICAL_ENVIRONMENT must be a non-empty environment slug.')
                    }
                    if (params.HOMELAB_INFISICAL_PROJECT_SLUG.contains('/') || params.HOMELAB_INFISICAL_PROJECT_SLUG.contains('\n')) {
                        error('HOMELAB_INFISICAL_PROJECT_SLUG must not contain slashes or newlines.')
                    }
                    def uuidPattern = /^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$/
                    if (!(params.INFISICAL_READ_CLIENT_ID ==~ uuidPattern) || !(params.INFISICAL_WRITE_CLIENT_ID ==~ uuidPattern)) {
                        error('Both Infisical Client IDs must be UUIDs.')
                    }
                    if (!params.INFISICAL_READ_CLIENT_SECRET || params.INFISICAL_READ_CLIENT_SECRET.length() < 16 ||
                        !params.INFISICAL_WRITE_CLIENT_SECRET || params.INFISICAL_WRITE_CLIENT_SECRET.length() < 16) {
                        error('Both Infisical Client Secrets must be supplied and contain at least 16 characters.')
                    }
                    saveInfisicalCredentials(
                        params.INFISICAL_READ_CLIENT_ID,
                        params.INFISICAL_READ_CLIENT_SECRET,
                        params.INFISICAL_WRITE_CLIENT_ID,
                        params.INFISICAL_WRITE_CLIENT_SECRET,
                        params.HOMELAB_INFISICAL_PROJECT_ID,
                        params.HOMELAB_INFISICAL_CREDENTIAL_ID,
                        params.HOMELAB_INFISICAL_URL,
                        params.HOMELAB_INFISICAL_ENVIRONMENT,
                        params.HOMELAB_INFISICAL_PROJECT_SLUG
                    )
                }
                echo 'Saved the Infisical connection settings and created or rotated the Machine Identity credentials; verifying both logins.'
            }
        }

        stage('Verify saved credentials') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    usernamePassword(credentialsId: 'infisical-homelab-prod-writer-api', usernameVariable: 'INFISICAL_WRITE_CLIENT_ID', passwordVariable: 'INFISICAL_WRITE_CLIENT_SECRET')
                ]) {
                    withEnv(["INFISICAL_URL=${params.HOMELAB_INFISICAL_URL}"]) {
                        sh(label: 'Authenticate both Infisical Machine Identities', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/infisical-setup/verify-machine-identities.py
''')
                    }
                }
            }
        }
    }
}

@com.cloudbees.groovy.cps.NonCPS
def saveInfisicalCredentials(String readClientId, String readClientSecret, String writeClientId, String writeClientSecret, String projectId, String readCredentialId, String baseUrl, String environment, String projectSlug) {
    def identities = [
        [name: 'read-only', id: readClientId, secret: readClientSecret,
         universalId: readCredentialId, apiId: 'infisical-homelab-prod-read-api'],
        [name: 'read/write', id: writeClientId, secret: writeClientSecret,
         universalId: 'infisical-homelab-prod-writer', apiId: 'infisical-homelab-prod-writer-api']
    ]
    def provider = com.cloudbees.plugins.credentials.SystemCredentialsProvider.getInstance()
    def domainCredentials = new LinkedHashMap(provider.getDomainCredentialsMap())
    def globalCredentials = new ArrayList(domainCredentials.get(com.cloudbees.plugins.credentials.domains.Domain.global()) ?: [])

    identities.each { identity ->
        def universalCredential = new io.jenkins.plugins.infisicaljenkins.credentials.InfisicalUniversalAuthCredential(
            com.cloudbees.plugins.credentials.CredentialsScope.GLOBAL,
            identity.universalId,
            'Infisical Universal Auth for Homelab Jenkins',
            identity.id,
            identity.secret
        )
        def apiCredential = new com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl(
            com.cloudbees.plugins.credentials.CredentialsScope.GLOBAL,
            identity.apiId,
            'Infisical Universal Auth for API calls from Jenkins pipelines',
            identity.id,
            identity.secret
        )
        [universalCredential, apiCredential].each { replacement ->
            globalCredentials.removeAll { existing -> existing.id == replacement.id }
            globalCredentials.add(replacement)
        }
    }

    [
        'homelab-infisical-project-id': projectId,
        'homelab-infisical-url': baseUrl,
        'homelab-infisical-environment': environment,
        'homelab-infisical-project-slug': projectSlug
    ].each { credentialId, value ->
        def credential = new org.jenkinsci.plugins.plaincredentials.impl.StringCredentialsImpl(
            com.cloudbees.plugins.credentials.CredentialsScope.GLOBAL,
            credentialId,
            "Homelab Infisical setting: ${credentialId}",
            hudson.util.Secret.fromString(value)
        )
        globalCredentials.removeAll { existing -> existing.id == credentialId }
        globalCredentials.add(credential)
    }

    domainCredentials.put(com.cloudbees.plugins.credentials.domains.Domain.global(), globalCredentials)
    provider.setDomainCredentialsMap(domainCredentials)
    provider.save()
}
