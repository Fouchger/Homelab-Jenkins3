pipeline {
    agent { label 'homelab-automation' }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(name: 'PROXMOX_USER', defaultValue: 'homelab-automation@pve', description: 'Existing Proxmox account shown in the cluster user list.')
        string(name: 'PROXMOX_ROLE', defaultValue: 'HomelabLxcOperator', description: 'Existing custom role shown in the cluster roles list.')
        string(name: 'PROXMOX_STORAGE_IDS', defaultValue: 'local,local-lvm', description: 'Storage IDs the automation account may allocate space on.')
        string(name: 'PROXMOX_API_HOSTNAME', defaultValue: 'pve01.fouchger.uk', description: 'DNS name used by API clients; it must resolve to the Proxmox host and be covered by its HTTPS certificate.')
        booleanParam(name: 'ENSURE_API_CERTIFICATE', defaultValue: true, description: 'Ensure the Proxmox API certificate includes PROXMOX_API_HOSTNAME using the existing ACME account and Cloudflare DNS token in Infisical. Issuing a certificate restarts pveproxy briefly.')
    }

    stages {
        stage('Rotate Proxmox API token') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    usernamePassword(credentialsId: 'infisical-homelab-prod-writer-api', usernameVariable: 'INFISICAL_WRITE_CLIENT_ID', passwordVariable: 'INFISICAL_WRITE_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-proxmox-host', variable: 'PROXMOX_HOST'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT'),
                    string(credentialsId: 'homelab-infisical-project-slug', variable: 'INFISICAL_PROJECT_SLUG')
                ]) {
                    withEnv([
                        "PROXMOX_USER=${params.PROXMOX_USER}",
                        "PROXMOX_ROLE=${params.PROXMOX_ROLE}",
                        "PROXMOX_STORAGE_IDS=${params.PROXMOX_STORAGE_IDS}",
                        "PROXMOX_API_HOSTNAME=${params.PROXMOX_API_HOSTNAME}",
                        "ENSURE_API_CERTIFICATE=${params.ENSURE_API_CERTIFICATE}"
                    ]) {
                        sh(label: 'Ensure Proxmox ACME certificate and rotate API token', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/proxmox-access/provision-proxmox-access.py
''')
                    }
                }
            }
        }
    }
}
