pipeline {
    agent { label 'homelab-automation' }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 25, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Review planned MikroTik changes') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    withEnv(['HOMELAB_REQUIRE_MIKROTIK_REVIEW=yes']) {
                    sh(label: 'Verify router and show routine change plan', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/network-settings/review-mikrotik-settings.py
''')
                    }
                }
            }
        }
        stage('Approve routine changes') {
            steps {
            input message: 'Review the RouterOS plan above, including tagged VLAN 80 membership, VLAN 80 inclusion in the LANS destination list for management-to-internal routing, static DHCP reservations and router DNS records for all Talos nodes, DHCP network/gateway, DNS settings, Proxmox API DNS, restricted Jenkins-agent access to Talos TCP/50000 and API VIP TCP/6443, Talos VLAN 80 access to OMV 192.168.70.20 on NFSv4 TCP/2049 only, and the proposed direct Kubernetes service IP range 192.168.80.210-192.168.80.219 after checking DHCP pools, leases, ARP, and router DNS for conflicts. If correct, Jenkins will enable SSH login for the backup user only when its RouterOS group is dedicated to that user, authorize Jenkins’s saved SSH key if needed, create and encrypt pre-change text and binary backups over pinned SSH, then apply the approved settings. If the group is shared, Jenkins stops without changing group permissions. RouterOS key authorization disables password-based SSH login for that user, so use a dedicated Jenkins backup account. No changes are made before approval.', ok: 'Back up and apply changes'
            }
        }
        stage('Back up and configure MikroTik') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    sh(label: 'Use Infisical configuration to back up and update RouterOS', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/mikrotik-config/apply-mikrotik-config.py
''')
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "artifacts/${env.BUILD_NUMBER}/homelab-router-before-dns-*.tar.enc", allowEmptyArchive: true, fingerprint: true
        }
    }
}
