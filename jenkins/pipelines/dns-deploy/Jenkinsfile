pipeline {
    agent { label 'homelab-automation' }

    parameters {
        choice(
            name: 'DNS01_ACTION',
            choices: ['reuse', 'destroy-and-recreate'],
            description: 'dns01 (192.168.30.2): reuse the existing container or destroy and recreate it. If both servers are selected, Jenkins rebuilds them sequentially and verifies the peer is online before each deletion.'
        )
        choice(
            name: 'DNS02_ACTION',
            choices: ['reuse', 'destroy-and-recreate'],
            description: 'dns02 (192.168.30.3): reuse the existing container or destroy and recreate it. If both servers are selected, Jenkins rebuilds them sequentially and verifies the peer is online before each deletion.'
        )
    }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Review DNS deployment and router changes') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT'),
                    string(credentialsId: 'homelab-proxmox-host', variable: 'PROXMOX_HOST')
                ]) {
                    withEnv([
                        'HOMELAB_REQUIRE_MIKROTIK_REVIEW=yes',
                        "HOMELAB_DNS01_ACTION=${params.DNS01_ACTION ?: 'reuse'}",
                        "HOMELAB_DNS02_ACTION=${params.DNS02_ACTION ?: 'reuse'}"
                    ]) {
                        sh(label: 'Show read-only DNS deployment plan', script: '''#!/bin/sh
set -eu
set +x
python3 -u jenkins/pipelines/dns-deploy/deploy-dns.py --plan
python3 -u jenkins/pipelines/network-settings/review-mikrotik-settings.py
''')
                    }
                }
            }
        }
        stage('Approve DNS deployment') {
            steps {
                input message: "Review the DNS server plan and the MikroTik DNS/DHCP differences above. Jenkins will ensure pve01.fouchger.uk -> 192.168.20.10 in MikroTik DNS and the Technitium primary zone, replicate that zone to dns02, and update Jenkins agent CTID 101 to use both Technitium DNS servers without rebooting the running agent. Per-server actions: dns01=${params.DNS01_ACTION ?: 'reuse'}, dns02=${params.DNS02_ACTION ?: 'reuse'}. Jenkins handles selected servers sequentially, creating an absent peer first when that is needed to keep a DNS server online. Before each deletion, Jenkins verifies the peer container, expected IP, Technitium admin access, and UDP/53 DNS response; recreation stops if the peer is unhealthy. Before dns01 is taken offline, Jenkins preserves its primary zone files and restores them on the replacement, then synchronizes them to dns02 before taking dns02 offline. For a protected container, Jenkins temporarily disables Proxmox protection and restores it if deletion fails. The normal encrypted MikroTik backup still runs before router changes. If recreation fails, the selected server may remain deleted; if the later router backup or sync fails, DNS servers may already be updated while router DHCP remains unchanged. No changes occur before approval.", ok: 'Deploy DNS and sync router'
            }
        }
        stage('Create and configure DNS servers') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT'),
                    string(credentialsId: 'homelab-proxmox-host', variable: 'PROXMOX_HOST')
                ]) {
                    withEnv([
                        "HOMELAB_DNS01_ACTION=${params.DNS01_ACTION ?: 'reuse'}",
                        "HOMELAB_DNS02_ACTION=${params.DNS02_ACTION ?: 'reuse'}"
                    ]) {
                        sh(label: 'Provision DNS LXCs sequentially and configure Technitium', script: '''#!/bin/sh
set -eu
set +x
python3 -u jenkins/pipelines/dns-deploy/deploy-dns.py
''')
                    }
                }
            }
        }
        stage('Sync MikroTik DNS and DHCP') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    withEnv(['HOMELAB_MIKROTIK_DNS_ONLY=yes']) {
                        sh(label: 'Back up router and apply DNS, DHCP, and Proxmox API hostname', script: '''#!/bin/sh
set +x
python3 -u jenkins/pipelines/mikrotik-config/apply-mikrotik-config.py
''')
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "artifacts/${env.BUILD_NUMBER}/homelab-router-before-dns-*.tar.enc", allowEmptyArchive: true, fingerprint: true
        }
    }
}
