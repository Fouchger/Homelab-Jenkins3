pipeline {
    agent { label 'homelab-automation' }

    parameters {
        choice(
            name: 'RECREATE_DNS_SERVER',
            choices: ['none', 'dns01', 'dns02'],
            description: 'Select at most one DNS server to replace with a clean container. Its existing DNS settings, zones, and records will be permanently deleted with no DNS-container backup; the other server will be reused. Default: none.'
        )
    }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Review DNS deployment and router changes') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT'),
                    string(credentialsId: 'homelab-proxmox-host', variable: 'PROXMOX_HOST')
                ]) {
                    withEnv([
                        'HOMELAB_REQUIRE_MIKROTIK_REVIEW=yes',
                        "HOMELAB_RECREATE_DNS_SERVER=${params.RECREATE_DNS_SERVER ?: 'none'}"
                    ]) {
                        sh(label: 'Show read-only DNS deployment plan', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/dns-deploy/deploy-dns.py --plan
python3 jenkins/pipelines/network-settings/review-mikrotik-settings.py
''')
                    }
                }
            }
        }
        stage('Approve DNS deployment') {
            steps {
                input message: "Review the DNS server plan and the MikroTik DNS/DHCP differences above. Recreate selection: ${params.RECREATE_DNS_SERVER ?: 'none'}. If dns01 or dns02 is selected, Jenkins will permanently delete that one matching managed container and all of its DNS data, with no DNS-container backup, then create a clean replacement; the other server stays in place. The normal encrypted MikroTik backup still runs before router changes. After recreation, Jenkins configures zone replication and syncs DHCP DNS. If recreation fails, the selected server may remain deleted; if the later router backup or sync fails, DNS servers may already be updated while router DHCP remains unchanged. No changes occur before approval.", ok: (params.RECREATE_DNS_SERVER == 'dns01' || params.RECREATE_DNS_SERVER == 'dns02') ? "Delete and recreate ${params.RECREATE_DNS_SERVER}" : 'Deploy DNS and sync router'
            }
        }
        stage('Create and configure DNS servers') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT'),
                    string(credentialsId: 'homelab-proxmox-host', variable: 'PROXMOX_HOST')
                ]) {
                    withEnv(["HOMELAB_RECREATE_DNS_SERVER=${params.RECREATE_DNS_SERVER ?: 'none'}"]) {
                        sh(label: 'Provision both DNS LXCs and configure Technitium', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/dns-deploy/deploy-dns.py
''')
                    }
                }
            }
        }
        stage('Sync MikroTik DNS and DHCP') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    withEnv(['HOMELAB_MIKROTIK_DNS_ONLY=yes']) {
                        sh(label: 'Back up router and apply DNS/DHCP resolver settings', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/mikrotik-config/apply-mikrotik-config.py
''')
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "artifacts/${env.BUILD_NUMBER}/homelab-router-before-dns-*.tar.enc", allowEmptyArchive: true, fingerprint: true
        }
    }
}
