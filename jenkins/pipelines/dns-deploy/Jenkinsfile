pipeline {
    agent { label 'homelab-automation' }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Review DNS deployment and router changes') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT'),
                    string(credentialsId: 'homelab-proxmox-host', variable: 'PROXMOX_HOST')
                ]) {
                    withEnv(['HOMELAB_REQUIRE_MIKROTIK_REVIEW=yes']) {
                        sh(label: 'Show read-only DNS deployment plan', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/dns-deploy/deploy-dns.py --plan
python3 jenkins/pipelines/network-settings/review-mikrotik-settings.py
''')
                    }
                }
            }
        }
        stage('Approve DNS deployment') {
            steps {
                input message: 'Review the DNS server plan and the MikroTik DNS/DHCP differences above. After approval, Jenkins creates or reuses both DNS servers and configures zone replication before backing up the router and syncing DHCP DNS. If the router backup or sync fails, DNS servers may already be updated while router DHCP remains unchanged. No services change before approval.', ok: 'Deploy DNS and sync router'
            }
        }
        stage('Create and configure DNS servers') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT'),
                    string(credentialsId: 'homelab-proxmox-host', variable: 'PROXMOX_HOST')
                ]) {
                    sh(label: 'Provision both DNS LXCs and configure Technitium', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/dns-deploy/deploy-dns.py
''')
                }
            }
        }
        stage('Sync MikroTik DNS and DHCP') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    withEnv(['HOMELAB_MIKROTIK_DNS_ONLY=yes']) {
                        sh(label: 'Back up router and apply DNS/DHCP resolver settings', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/mikrotik-config/apply-mikrotik-config.py
''')
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "artifacts/${env.BUILD_NUMBER}/homelab-router-before-dns-*.tar.enc", allowEmptyArchive: true, fingerprint: true
        }
    }
}
