pipeline {
    agent { label 'homelab-automation' }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        password(name: 'DNS01_ROOT_PASSWORD', defaultValue: '', description: '/proxmox/lxc/dns01/LXC_ROOT_PASSWORD — Concealed. Optional LXC root password for dns01. Blank keeps the existing Infisical value.')
        password(name: 'DNS02_ROOT_PASSWORD', defaultValue: '', description: '/proxmox/lxc/dns02/LXC_ROOT_PASSWORD — Concealed. Optional LXC root password for dns02. Blank keeps the existing Infisical value.')
        choice(name: 'MIKROTIK_DHCP_DNS_MODE', choices: ['', 'router', 'direct'], description: '/dns/MIKROTIK_DHCP_DNS_MODE — Optional DHCP DNS mode. Choose router (MikroTik resolver) or direct (Technitium). Leave blank to keep the current Infisical value.')
        string(name: 'DNS_PUBLIC_FALLBACKS', defaultValue: '', description: '/dns/DNS_PUBLIC_FALLBACKS — Optional comma-separated public DNS resolver IPs used only after both Technitium servers fail.')
        string(name: 'DNS_HOSTED_ZONES', defaultValue: '', description: '/dns/DNS_HOSTED_ZONES — Optional comma-separated domains to create as primary zones on dns01 and replicate to dns02. Blank keeps the current Infisical value.')
        string(name: 'DNS01_IPV4', defaultValue: '', description: '/dns/dns01/DNS_IPV4 — Optional DNS01 address saved as /dns/dns01/DNS_IPV4. Blank keeps the current value.')
        password(name: 'DNS01_ADMIN_PASSWORD', defaultValue: '', description: '/dns/dns01/DNS_SERVER_ADMIN_PASSWORD — Concealed. Optional Technitium admin password saved as /dns/dns01/DNS_SERVER_ADMIN_PASSWORD. Blank keeps the existing Infisical value.')
        string(name: 'DNS02_IPV4', defaultValue: '', description: '/dns/dns02/DNS_IPV4 — Optional DNS02 address saved as /dns/dns02/DNS_IPV4. Blank keeps the current value.')
        password(name: 'DNS02_ADMIN_PASSWORD', defaultValue: '', description: '/dns/dns02/DNS_SERVER_ADMIN_PASSWORD — Concealed. Optional Technitium admin password saved as /dns/dns02/DNS_SERVER_ADMIN_PASSWORD. Blank keeps the existing Infisical value.')
        string(name: 'MIKROTIK_HOST', defaultValue: '', description: '/mikrotik/router01/MIKROTIK_HOST — Router management IP/hostname reachable by Jenkins, e.g. 192.168.20.1 or router.example.local. Enter the address only: no https://, port, or path.')
        string(name: 'MIKROTIK_IP', defaultValue: '', description: '/mikrotik/router01/MIKROTIK_IP — Optional router IPv4 address Jenkins must reconnect to after a full reset. It must be configured on the direct Proxmox/ether2 path by MIKROTIK_SCRIPT.')
        string(name: 'MIKROTIK_USERNAME', defaultValue: '', description: '/mikrotik/router01/MIKROTIK_USERNAME — Optional RouterOS administrator username created or maintained by the full reset workflow.')
        password(name: 'MIKROTIK_PASSWORD', defaultValue: '', description: '/mikrotik/router01/MIKROTIK_PASSWORD — Concealed. Password for MIKROTIK_USERNAME.')
        string(name: 'MIKROTIK_BOOTSTRAP_USERNAME', defaultValue: '', description: '/mikrotik/router01/MIKROTIK_BOOTSTRAP_USERNAME — Existing RouterOS administrator username used to authorize Jenkins SSH access and start the reset workflow.')
        password(name: 'MIKROTIK_BOOTSTRAP_PASSWORD', defaultValue: '', description: '/mikrotik/router01/MIKROTIK_BOOTSTRAP_PASSWORD — Concealed. Password for the existing MIKROTIK_BOOTSTRAP_USERNAME account.')
        string(name: 'MIKROTIK_SSH_USER', defaultValue: '', description: '/mikrotik/router01/MIKROTIK_SSH_USER — RouterOS user for pinned Jenkins SSH backups and full-reset recovery. Job 004 authorizes the saved Jenkins public key after approval if needed.')
        choice(name: 'MIKROTIK_SSH_HOST_KEY_UPDATE', choices: ['no', 'yes'], description: '/mikrotik/router01/MIKROTIK_SSH_HOST_KEY — Every run tests the SSH host key against the key fetched from RouterOS over the pinned HTTPS connection. Choose yes to save/update the verified SSH host key; no runs the check without changing the saved host key.')
        string(name: 'MIKROTIK_TLS_CERT_SHA256', defaultValue: '', description: '/mikrotik/router01/MIKROTIK_TLS_CERT_SHA256 — In MikroTik WinBox > New Terminal, run /ip/service/print detail where name=www-ssl and note the certificate assigned to www-ssl. Then run /certificate/print detail where name="<certificate name>". Replace the placeholder with that certificate name and copy its fingerprint (64 hexadecimal characters) into Infisical at /mikrotik/router01/MIKROTIK_TLS_CERT_SHA256, or enter it here for Job 003 to save after verification. Job 003 compares it with the certificate served at MIKROTIK_HOST:443. Once HTTPS trust is established, Job 003 automatically verifies the SSH host key through that pinned connection; no SSH fingerprint entry is needed.')
        password(name: 'BINARY_BACKUP_PASSWORD', defaultValue: '', description: '/mikrotik/backup/BINARY_BACKUP_PASSWORD — Concealed. Required to encrypt Job 004 pre-change text and binary backups and Job 005 full-reset backups; saved under /mikrotik/backup.')
        password(name: 'SEC_GUEST_PASSWORD', defaultValue: '', description: '/mikrotik/wifi_security/SEC_GUEST_PASSWORD — Concealed. Optional Guest Wi-Fi password; saved under /mikrotik/wifi_security.')
        password(name: 'SEC_IOT_PASSWORD', defaultValue: '', description: '/mikrotik/wifi_security/SEC_IOT_PASSWORD — Concealed. Optional IoT Wi-Fi password; saved under /mikrotik/wifi_security.')
        password(name: 'SEC_MGMT_PASSWORD', defaultValue: '', description: '/mikrotik/wifi_security/SEC_MGMT_PASSWORD — Concealed. Optional Management Wi-Fi password; saved under /mikrotik/wifi_security.')
        password(name: 'SEC_USERS_PASSWORD', defaultValue: '', description: '/mikrotik/wifi_security/SEC_USERS_PASSWORD — Concealed. Optional Users Wi-Fi password; saved under /mikrotik/wifi_security.')
        string(name: 'CLOUDFLARE_ACCOUNT_ID', defaultValue: '', description: '/cloudflare/CLOUDFLARE_ACCOUNT_ID — Optional Cloudflare account ID saved under /cloudflare.')
        password(name: 'CLOUDFLARE_API_TOKEN', defaultValue: '', description: '/cloudflare/CLOUDFLARE_API_TOKEN — Concealed. Optional Cloudflare API token. Blank keeps the existing token; the value is stored only in Infisical.')
        string(name: 'CLOUDFLARE_DOMAIN_1', defaultValue: '', description: '/cloudflare/CLOUDFLARE_DOMAIN_1 — Optional first Cloudflare-managed domain, for example example.com. Leave blank until decided.')
        string(name: 'CLOUDFLARE_DOMAIN_2', defaultValue: '', description: '/cloudflare/CLOUDFLARE_DOMAIN_2 — Optional second Cloudflare-managed domain. Leave blank until decided.')
        string(name: 'CLOUDFLARE_ZONE_ID_1', defaultValue: '', description: '/cloudflare/CLOUDFLARE_ZONE_ID_1 — Optional Cloudflare Zone ID for the first domain.')
        string(name: 'CLOUDFLARE_ZONE_ID_2', defaultValue: '', description: '/cloudflare/CLOUDFLARE_ZONE_ID_2 — Optional Cloudflare Zone ID for the second domain.')
        string(name: 'DOCKFLARE_ACCESS_EMAILS', defaultValue: '', description: '/dockflare/DOCKFLARE_ACCESS_EMAILS — Optional comma-separated email allowlist for protected services, saved under /dockflare.')
        string(name: 'DOCKFLARE_ADMIN_CIDRS', defaultValue: '', description: '/dockflare/DOCKFLARE_ADMIN_CIDRS — Optional comma-separated CIDR ranges allowed to reach DockFlare administration, saved under /dockflare.')
    }

    stages {
        stage('Save configurable DNS and Cloudflare settings') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-writer-api', usernameVariable: 'INFISICAL_WRITE_CLIENT_ID', passwordVariable: 'INFISICAL_WRITE_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    sh(label: 'Validate and save settings in Infisical', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/network-settings/save-network-settings.py
''')
                }
                }
            }
        }

        stage('Review MikroTik connection and planned changes') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    sh(label: 'Verify pinned RouterOS connection and preview managed settings', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/network-settings/review-mikrotik-settings.py
''')
                }
            }
        }
    }
}
