pipeline {
    agent { label 'homelab-automation' }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(name: 'DNS01_IPV4', defaultValue: '', description: 'Optional DNS01 address saved as /dns/dns01/DNS_IPV4. Blank keeps the current value.')
        string(name: 'DNS02_IPV4', defaultValue: '', description: 'Optional DNS02 address saved as /dns/dns02/DNS_IPV4. Blank keeps the current value.')
        string(name: 'DNS_PUBLIC_FALLBACKS', defaultValue: '', description: 'Optional comma-separated public DNS resolver IPs used only after both Technitium servers fail.')
        string(name: 'MIKROTIK_DHCP_DNS_MODE', defaultValue: '', description: 'Optional DHCP DNS mode: router/MikroTik resolver or direct/Technitium. Blank keeps the current Infisical value.')
        password(name: 'DNS01_ROOT_PASSWORD', defaultValue: '', description: 'Optional LXC root password for dns01. Blank keeps the existing Infisical value.')
        password(name: 'DNS02_ROOT_PASSWORD', defaultValue: '', description: 'Optional LXC root password for dns02. Blank keeps the existing Infisical value.')
        password(name: 'DNS01_ADMIN_PASSWORD', defaultValue: '', description: 'Optional Technitium admin password saved as /dns/dns01/DNS_SERVER_ADMIN_PASSWORD. Blank keeps the existing Infisical value.')
        password(name: 'DNS02_ADMIN_PASSWORD', defaultValue: '', description: 'Optional Technitium admin password saved as /dns/dns02/DNS_SERVER_ADMIN_PASSWORD. Blank keeps the existing Infisical value.')
        string(name: 'DNS_HOSTED_ZONES', defaultValue: '', description: 'Optional comma-separated domains to create as primary zones on dns01 and replicate to dns02. Blank keeps the current Infisical value.')

        string(name: 'MIKROTIK_HOST', defaultValue: '', description: 'Router management IP/hostname reachable by Jenkins, e.g. 192.168.20.1 or router.example.local. Enter the address only: no https://, port, or path.')
        string(name: 'MIKROTIK_IP', defaultValue: '', description: 'Optional router IPv4 address Jenkins must reconnect to after a full reset. It must be configured on the direct Proxmox/ether2 path by MIKROTIK_SCRIPT.')
        string(name: 'MIKROTIK_USERNAME', defaultValue: '', description: 'Optional RouterOS administrator username created or maintained by the full reset workflow.')
        password(name: 'MIKROTIK_PASSWORD', defaultValue: '', description: 'Password for MIKROTIK_USERNAME.')
        string(name: 'MIKROTIK_BOOTSTRAP_USERNAME', defaultValue: '', description: 'Existing RouterOS administrator username used to authorize Jenkins SSH access and start the reset workflow.')
        password(name: 'MIKROTIK_BOOTSTRAP_PASSWORD', defaultValue: '', description: 'Password for the existing MIKROTIK_BOOTSTRAP_USERNAME account.')
        string(name: 'MIKROTIK_SSH_USER', defaultValue: '', description: 'Optional RouterOS username Jenkins will use after its public key is authorized on the router.')
        password(name: 'BINARY_BACKUP_PASSWORD', defaultValue: '', description: 'Optional password used to encrypt RouterOS pre-change exports and full-reset binary backups; saved under /mikrotik/backup.')
        password(name: 'SEC_GUEST_PASSWORD', defaultValue: '', description: 'Optional Guest Wi-Fi password; saved under /mikrotik/wifi_security.')
        password(name: 'SEC_IOT_PASSWORD', defaultValue: '', description: 'Optional IoT Wi-Fi password; saved under /mikrotik/wifi_security.')
        password(name: 'SEC_MGMT_PASSWORD', defaultValue: '', description: 'Optional Management Wi-Fi password; saved under /mikrotik/wifi_security.')
        password(name: 'SEC_USERS_PASSWORD', defaultValue: '', description: 'Optional Users Wi-Fi password; saved under /mikrotik/wifi_security.')
        string(name: 'MIKROTIK_SSH_HOST_KEY_FINGERPRINT', defaultValue: '', description: 'Only needed when saving a new SSH host key. In a trusted WinBox Terminal run /ip/ssh/print and copy the host-key-fingerprint value exactly, including the SHA256: prefix. Job 003 compares it with the key scanned from MIKROTIK_HOST before trusting/saving that SSH host key. This SSH fingerprint is separate from MIKROTIK_TLS_CERT_SHA256.')
        string(name: 'MIKROTIK_TLS_CERT_SHA256', defaultValue: '', description: 'To obtain it: in a trusted WinBox Terminal run /ip/service/print detail where name=www-ssl and note its certificate name; then run /certificate/print detail where name="<certificate name>" and copy fingerprint (64 hex characters). Paste here without spaces. Job 003 checks it against the certificate Jenkins sees at MIKROTIK_HOST:443 before saving to /mikrotik/router01/MIKROTIK_TLS_CERT_SHA256. On the first run, Job 003 prints the observed value; verify it in RouterOS and rerun with it.')

        string(name: 'CLOUDFLARE_ACCOUNT_ID', defaultValue: '', description: 'Optional Cloudflare account ID saved under /cloudflare.')
        password(name: 'CLOUDFLARE_API_TOKEN', defaultValue: '', description: 'Optional Cloudflare API token. Blank keeps the existing token; the value is stored only in Infisical.')
        string(name: 'CLOUDFLARE_DOMAIN_1', defaultValue: '', description: 'Optional first Cloudflare-managed domain, for example example.com. Leave blank until decided.')
        string(name: 'CLOUDFLARE_DOMAIN_2', defaultValue: '', description: 'Optional second Cloudflare-managed domain. Leave blank until decided.')
        string(name: 'CLOUDFLARE_ZONE_ID_1', defaultValue: '', description: 'Optional Cloudflare Zone ID for the first domain.')
        string(name: 'CLOUDFLARE_ZONE_ID_2', defaultValue: '', description: 'Optional Cloudflare Zone ID for the second domain.')
        string(name: 'DOCKFLARE_ACCESS_EMAILS', defaultValue: '', description: 'Optional comma-separated email allowlist for protected services, saved under /dockflare.')
        string(name: 'DOCKFLARE_ADMIN_CIDRS', defaultValue: '', description: 'Optional comma-separated CIDR ranges allowed to reach DockFlare administration, saved under /dockflare.')
    }

    stages {
        stage('Save configurable DNS and Cloudflare settings') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-writer-api', usernameVariable: 'INFISICAL_WRITE_CLIENT_ID', passwordVariable: 'INFISICAL_WRITE_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    sh(label: 'Validate and save settings in Infisical', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/network-settings/save-network-settings.py
''')
                }
            }
        }

        stage('Review MikroTik connection and planned changes') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    sh(label: 'Verify pinned RouterOS connection and preview managed settings', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/network-settings/review-mikrotik-settings.py
''')
                }
            }
        }
    }
}
