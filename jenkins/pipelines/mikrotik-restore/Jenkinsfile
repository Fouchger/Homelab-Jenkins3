pipeline {
    agent { label 'homelab-automation' }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Check reset and restore readiness') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    sh(label: 'Verify reset prerequisites without changing the router', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/mikrotik-restore/restore-mikrotik.py --check
''')
                }
            }
        }
        stage('Approve destructive full reset') {
            steps {
                input message: 'DESTRUCTIVE RECOVERY: this erases the MikroTik configuration and interrupts the router connection. Jenkins checked the saved script and verified SSH access or verified the current SSH key through the pinned HTTPS certificate. After approval, it will save an encrypted backup, preserve the SSH key, run a RouterOS dry-run, reset the router, then refresh the SSH host-key pin in Infisical over the same pinned HTTPS identity before verifying recovery at MIKROTIK_IP over ether2. Use only when the separate recovery action is intended.', ok: 'I understand — back up, reset, and restore'
            }
        }
        stage('Back up, reset, and restore MikroTik') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    usernamePassword(credentialsId: 'infisical-homelab-prod-writer-api', usernameVariable: 'INFISICAL_WRITE_CLIENT_ID', passwordVariable: 'INFISICAL_WRITE_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    sh(label: 'Reset and restore RouterOS from Infisical configuration', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/mikrotik-restore/restore-mikrotik.py
''')
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "artifacts/${env.BUILD_NUMBER}/homelab-router-before-*.backup", allowEmptyArchive: true, fingerprint: true
        }
    }
}
