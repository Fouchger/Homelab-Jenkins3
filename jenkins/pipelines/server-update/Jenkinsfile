pipeline {
    agent { label 'homelab-automation' }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    triggers {
        extendedCron('''TZ=Pacific/Auckland
0 2 * * *
%AUTOMATED_UPDATE=true''')
    }

    parameters {
        booleanParam(name: 'AUTOMATED_UPDATE', defaultValue: false, description: 'Set by the daily timer. Leave disabled for manual runs so they require confirmation.')
        string(name: 'PROXMOX_HOST', defaultValue: '192.168.20.10', description: 'Proxmox host reachable from the Jenkins automation agent.')
        string(name: 'GITHUB_OWNER', defaultValue: 'Fouchger', description: 'Repository owner used by the Proxmox bootstrap download.')
        string(name: 'GITHUB_REPOSITORY', defaultValue: 'Homelab-Jenkins3', description: 'Repository name used by the Proxmox bootstrap download.')
        string(name: 'INFISICAL_URL', defaultValue: 'https://app.infisical.com', description: 'Infisical server URL.')
        string(name: 'INFISICAL_PROJECT_ID', defaultValue: '535a4605-d859-4fad-b244-656c74a747b4', description: 'Infisical Homelab-Jenkins project UUID.')
        string(name: 'INFISICAL_ENVIRONMENT', defaultValue: 'prod', description: 'Infisical environment slug.')
    }

    stages {
        stage('Checkout latest configured branch revision') {
            steps {
                checkout scm
                script {
                    env.UPDATE_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    echo "Preparing server update from commit ${env.UPDATE_COMMIT}."
                }
            }
        }

        stage('Confirm update') {
            when {
                expression { !params.AUTOMATED_UPDATE }
            }
            steps {
                input(message: "Update both matching Jenkins LXCs from commit ${env.UPDATE_COMMIT}?", ok: 'Update both servers')
            }
        }

        stage('Update controller and agent') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'github-homelab-jenkins-readonly', usernameVariable: 'GITHUB_CREDENTIAL_USER', passwordVariable: 'GITHUB_TOKEN'),
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    sshUserPrivateKey(credentialsId: 'pve01-automation-ssh', keyFileVariable: 'PROXMOX_SSH_KEY_FILE', usernameVariable: 'PROXMOX_SSH_USER')
                ]) {
                    sh(label: 'Update both matching Jenkins LXCs from this repository revision', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/server-update/update-servers.py
''')
                }
            }
        }
    }
}
