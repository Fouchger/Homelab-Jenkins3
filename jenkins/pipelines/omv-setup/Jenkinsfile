pipeline {
    agent { label 'homelab-automation' }

    options {
        ansiColor('xterm')
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        choice(name: 'OPERATION', choices: ['INVENTORY', 'RESTORE', 'NFS', 'MEDIA'], description: 'INVENTORY captures the current server before rebuild. RESTORE reconstructs OMV service configuration from the protected Infisical OMV_RESTORE_INVENTORY secret after a clean OS install and disk reattachment. NFS reconciles the dedicated Kubernetes export. MEDIA adds VLAN 80-only NFS access to the existing TB4a, TB16a, TB10a, TB10b, and TB5a SMB folders while preserving SMB.')
        string(name: 'OMV_URL', defaultValue: 'http://192.168.70.20', description: 'OMV Workbench URL. Use a trusted HTTPS certificate if OMV HTTPS is configured.')
        string(name: 'PROXMOX_API_HOSTNAME', defaultValue: 'pve01.fouchger.uk', description: 'Certificate-valid Proxmox API hostname used to capture VM 22000 hardware configuration in the inventory artifact.')
        booleanParam(name: 'APPLY', defaultValue: false, description: 'Unchecked: read-only preflight/plan. Checked: require approval and apply the selected RESTORE, NFS, or MEDIA operation. INVENTORY is always read-only.')
        booleanParam(name: 'ALLOW_INSECURE_HTTP', defaultValue: false, description: 'Required only while OMV has no HTTPS certificate. Sends OMV credentials unencrypted over the trusted management LAN; use HTTPS with a valid certificate whenever available.')
    }

    stages {
        stage('Capture OMV rebuild inventory') {
            when { expression { params.OPERATION == 'INVENTORY' } }
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    withEnv(["OMV_ACTION=inventory", "OMV_ALLOW_INSECURE_HTTP=${params.ALLOW_INSECURE_HTTP}", "OMV_URL=${params.OMV_URL}", "PROXMOX_API_HOSTNAME=${params.PROXMOX_API_HOSTNAME}", 'OMV_INVENTORY_PATH=omv-inventory.json']) {
                        sh(label: 'Capture password-redacted OMV inventory', script: '''#!/bin/sh
set +x
python3 -u jenkins/pipelines/omv-setup/configure-omv.py
''')
                    }
                }
                archiveArtifacts artifacts: 'omv-inventory.json', fingerprint: true, onlyIfSuccessful: true
            }
        }

        stage('Inspect OMV and plan changes') {
            when { expression { params.OPERATION != 'INVENTORY' } }
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    withEnv(["OMV_ACTION=${params.OPERATION == 'RESTORE' ? 'restore-plan' : (params.OPERATION == 'MEDIA' ? 'media' : 'plan')}", "OMV_ALLOW_INSECURE_HTTP=${params.ALLOW_INSECURE_HTTP}", "OMV_URL=${params.OMV_URL}", "PROXMOX_API_HOSTNAME=${params.PROXMOX_API_HOSTNAME}"]) {
                        sh(label: params.OPERATION == 'RESTORE' ? 'Validate OMV rebuild inventory and restore plan' : (params.OPERATION == 'MEDIA' ? 'Review media NFS exports' : 'Read OMV state and calculate NFS changes'), script: '''#!/bin/sh
set +x
python3 -u jenkins/pipelines/omv-setup/configure-omv.py
''')
                    }
                }
            }
        }

        stage('Approve OMV changes') {
            when { expression { params.APPLY && params.OPERATION != 'INVENTORY' } }
            steps {
                script {
                    def message = params.OPERATION == 'RESTORE'
                        ? 'RESTORE applies the protected pre-rebuild OMV inventory after a clean OMV OS install. It will register ONLY the five exact pre-existing BTRFS filesystem UUIDs and recreate shared-folder, SMB/NFS, and local user/group configuration through OMV RPC. It never creates/formats filesystems, changes Proxmox hardware, or edits network settings. Confirm the five original physical disks are attached in their recorded SCSI slots and UUID/labels match. The OS installation and network recovery are manual prerequisites. Ensure replacement passwords are saved under /omv/user-passwords before approval.'
                        : (params.OPERATION == 'MEDIA'
                            ? 'MEDIA adds read/write NFS exports for the existing TB4a, TB16a, TB10a, TB10b, and TB5a shared folders, restricted to 192.168.80.0/24. Exports use root_squash, sync, and no_subtree_check. Existing SMB shares remain enabled and unchanged. This does not change data, ownership, SMB passwords, disks, or network settings. Kubernetes workloads must use the matching numeric file permissions (planned UID/GID 1000) and should be verified before allowing writes.'
                            : 'Jenkins will use the OMV administrator account from Infisical to enable NFS, ensure the Kubernetes shared folder exists on the uniquely detected TB4a mounted filesystem, and export it read/write to 192.168.80.0/24 with sync,no_subtree_check,no_root_squash. It applies only OMV NFS, shared-folder and bind-mount configuration; it does not format disks, alter network interfaces, or change SMB shares. The dedicated export grants root-level file access to VLAN 80 clients. Approve only if TB4a is the intended data filesystem.')
                    def button = params.OPERATION == 'RESTORE' ? 'Restore OMV configuration' : (params.OPERATION == 'MEDIA' ? 'Add media NFS exports' : 'Apply OMV NFS configuration')
                    input(message: message, ok: button)
                }
            }
        }

        stage('Apply and verify OMV NFS setup') {
            when { expression { params.APPLY && params.OPERATION == 'NFS' } }
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    withEnv(["OMV_ACTION=apply", "OMV_ALLOW_INSECURE_HTTP=${params.ALLOW_INSECURE_HTTP}", "OMV_URL=${params.OMV_URL}"]) {
                        sh(label: 'Reconcile OMV NFS configuration through OMV RPC', script: '''#!/bin/sh
set +x
python3 -u jenkins/pipelines/omv-setup/configure-omv.py
''')
                    }
                }
            }
        }

        stage('Apply and verify media NFS exports') {
            when { expression { params.APPLY && params.OPERATION == 'MEDIA' } }
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    withEnv(["OMV_ACTION=media-apply", "OMV_ALLOW_INSECURE_HTTP=${params.ALLOW_INSECURE_HTTP}", "OMV_URL=${params.OMV_URL}"]) {
                        sh(label: 'Add VLAN 80-only NFS exports without changing SMB', script: '''#!/bin/sh
set +x
python3 -u jenkins/pipelines/omv-setup/configure-omv.py
''')
                    }
                }
            }
        }

        stage('Restore OMV data services') {
            when { expression { params.APPLY && params.OPERATION == 'RESTORE' } }
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    withEnv(["OMV_ACTION=restore", "OMV_ALLOW_INSECURE_HTTP=${params.ALLOW_INSECURE_HTTP}", "OMV_URL=${params.OMV_URL}", "PROXMOX_API_HOSTNAME=${params.PROXMOX_API_HOSTNAME}"]) {
                        sh(label: 'Restore existing filesystems and OMV shares without formatting', script: '''#!/bin/sh
set +x
python3 -u jenkins/pipelines/omv-setup/configure-omv.py
''')
                    }
                }
            }
        }
    }

    post {
        always {
            sh(label: 'Remove temporary OMV inventory artifact from workspace', script: 'rm -f -- omv-inventory.json')
        }
    }
}
