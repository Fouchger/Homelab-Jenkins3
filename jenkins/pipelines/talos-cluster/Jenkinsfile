pipeline {
    agent { label 'homelab-automation' }
    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    parameters {
        booleanParam(name: 'INITIALIZE_CLUSTER', defaultValue: false, description: 'Authorize first setup, safe first-run resume, or initializing VMs you have already recreated. Replacing saved Talos secrets and bootstrapping is allowed only when all five VMs prove maintenance mode with the expected install disk and the API VIP is unused. APPLY is also required.')
        booleanParam(name: 'APPLY', defaultValue: false, description: 'Unchecked: read-only preflight. Checked: wait for approval, then perform the eligible initial setup/rebuild or reconcile Cilium on a healthy existing cluster. Existing-cluster machine configuration is not reapplied.')
    }
    stages {
        stage('Preflight Talos cluster') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    withEnv([
                        "TALOS_ACTION=plan",
                        "INITIALIZE_CLUSTER=${params.INITIALIZE_CLUSTER}"
                    ]) {
                        sh(label: 'Check Infisical state and all Talos nodes without changes', script: '''#!/bin/sh
set +x
python3 -u jenkins/pipelines/talos-cluster/configure-talos.py
''')
                    }
                }
            }
        }
        stage('Approve Talos cluster changes') {
            when { expression { params.APPLY } }
            steps {
                input message: "After you approve, Job 009 rechecks all five configured VMs and requires each to expose the expected install disk through the Talos maintenance API, with the Kubernetes API VIP unused. For an explicitly selected INITIALIZE_CLUSTER run, this also permits replacing stale saved Talos secrets after VMs were recreated; the new secrets are verified in Infisical before any node is configured. Talos is then installed and etcd bootstrapped once for this fresh set. A healthy existing cluster is health-checked and receives idempotent Cilium reconciliation only; its machine configuration is not reapplied. DHCP reservations must match kubernetes/talos/cluster.json. Flux and workloads remain separate.", ok: 'Configure Talos cluster'
            }
        }
        stage('Configure Talos and bootstrap') {
            when { expression { params.APPLY } }
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    usernamePassword(credentialsId: 'infisical-homelab-prod-writer-api', usernameVariable: 'INFISICAL_WRITE_CLIENT_ID', passwordVariable: 'INFISICAL_WRITE_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    withEnv([
                        "TALOS_ACTION=apply",
                        "INITIALIZE_CLUSTER=${params.INITIALIZE_CLUSTER}"
                    ]) {
                        sh(label: 'Configure Talos nodes and safely bootstrap', script: '''#!/bin/sh
set +x
python3 -u jenkins/pipelines/talos-cluster/configure-talos.py
''')
                    }
                }
            }
        }
    }
    post {
        always {
            sh(label: 'Remove temporary Talos credentials and machine configs', script: '''#!/bin/sh
set -eu
rm -rf -- "$WORKSPACE/.talos-private"
''')
        }
    }
}
