pipeline {
    agent { label 'homelab-automation' }
    environment {
        // Keep OpenTofu state durable outside the disposable Jenkins workspace.
        HOMELAB_KUBERNETES_STATE_DIR = '/var/lib/jenkins-agent/homelab/kubernetes'
    }
    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    parameters {
        string(name: 'PROXMOX_API_HOSTNAME', defaultValue: 'pve01.fouchger.uk', description: 'DNS hostname covered by the Proxmox API certificate. Job 002 ensures this certificate before Kubernetes provisioning.')
        text(name: 'CLUSTER_TFVARS', defaultValue: '''proxmox_bridge           = "vmbr0"
kubernetes_api_vip       = "192.168.80.200"
talos_iso_datastore_id   = "local"
talos_iso_proxmox_node   = "pve01"
talos_iso_file_name      = "talos-v1.13.10-metal-amd64.iso"
talos_iso_url            = "https://factory.talos.dev/image/376567988ad370138ad8b2698212367b8edcb69b5fd68c80be1f2ec7d603b4ba/v1.13.10/metal-amd64.iso"
talos_iso_checksum       = "699bfd71094ce138ed8e2013b05b07a1c82fe45bd7cce601e1f5de6ca04168bf"

nodes = {
  "talos-cp-01" = {
    role = "controlplane"
    vm_id = 8101
    proxmox_node = "pve01"
    datastore_id = "local-lvm"
    cores = 2
    memory_mb = 3072
    disk_gb = 32
    mac_address = "02:80:00:00:01:01"
    ip_address = "192.168.80.101"
  }
  "talos-cp-02" = {
    role = "controlplane"
    vm_id = 8102
    proxmox_node = "pve01"
    datastore_id = "local-lvm"
    cores = 2
    memory_mb = 3072
    disk_gb = 32
    mac_address = "02:80:00:00:01:02"
    ip_address = "192.168.80.102"
  }
  "talos-cp-03" = {
    role = "controlplane"
    vm_id = 8103
    proxmox_node = "pve01"
    datastore_id = "local-lvm"
    cores = 2
    memory_mb = 3072
    disk_gb = 32
    mac_address = "02:80:00:00:01:03"
    ip_address = "192.168.80.103"
  }
  "talos-worker-01" = {
    role = "worker"
    vm_id = 8111
    proxmox_node = "pve01"
    datastore_id = "local-lvm"
    cores = 2
    memory_mb = 3072
    disk_gb = 64
    mac_address = "02:80:00:00:02:01"
    ip_address = "192.168.80.104"
  }
  "talos-worker-02" = {
    role = "worker"
    vm_id = 8112
    proxmox_node = "pve01"
    datastore_id = "local-lvm"
    cores = 2
    memory_mb = 3072
    disk_gb = 64
    mac_address = "02:80:00:00:02:02"
    ip_address = "192.168.80.105"
  }
}''', description: 'Complete non-secret cluster configuration used for this run. Review or edit the VM IDs, IPs, MACs, host, sizing, VIP, and Talos ISO here before starting. Jenkins validates it and prints the exact infrastructure plan. Do not put credentials here; credentials come from Infisical.')
        booleanParam(name: 'APPLY', defaultValue: false, description: 'Unchecked: plan only. Checked: after Jenkins displays the plan, a second approval creates or updates the Talos ISO and the five VMs defined in CLUSTER_TFVARS. This does not install Talos or bootstrap Kubernetes.')
        choice(name: 'RECREATE_NODE', choices: ['NONE', 'talos-cp-01', 'talos-cp-02', 'talos-cp-03', 'talos-worker-01', 'talos-worker-02'], description: 'Select exactly one existing Talos VM to recreate with the corrected SCSI controller. Run a separate approved build for each VM. Other VMs remain running; the selected VM will be unavailable during replacement. NONE is the normal plan/apply mode.')
    }
    stages {
        stage('Validate OpenTofu configuration') {
            steps {
                sh(label: 'Format and validate Kubernetes VM configuration', script: '''#!/bin/sh
set -eu
tofu -chdir=tofu/environments/kubernetes fmt -check
tofu -chdir=tofu/environments/kubernetes init -backend=false -input=false
tofu -chdir=tofu/environments/kubernetes validate
''')
            }
        }
        stage('Plan Proxmox VM changes') {
            steps {
                script {
                    sh 'mkdir -p .review-tmp'
                    def clusterConfig = params.CLUSTER_TFVARS
                    if (!clusterConfig?.trim()) {
                        if (params.APPLY) {
                            error('The CLUSTER_TFVARS parameter has not been installed on this job yet. Run once with APPLY unchecked, then review the configuration parameter before any apply.')
                        }
                        clusterConfig = readFile('tofu/environments/kubernetes/cluster.tfvars.example')
                        echo 'CLUSTER_TFVARS is not available yet; using the tracked example for this parameter-refresh build.'
                    }
                    writeFile(file: '.review-tmp/cluster.tfvars', text: clusterConfig.trim() + '\n', encoding: 'UTF-8')
                    sh 'chmod 600 .review-tmp/cluster.tfvars'
                }
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    withEnv([
                        "PROXMOX_API_HOSTNAME=${params.PROXMOX_API_HOSTNAME}",
                        "HOMELAB_KUBERNETES_TFVARS=${env.WORKSPACE}/.review-tmp/cluster.tfvars",
                        'TOFU_ACTION=plan',
                        "RECREATE_NODE=${params.RECREATE_NODE}",
                        "TOFU_PLAN_FILE=${env.WORKSPACE}/.review-tmp/kubernetes-${env.BUILD_NUMBER}.tfplan"
                    ]) {
                        sh(label: 'Create reviewed OpenTofu plan', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/kubernetes-infra/run-tofu.py
''')
                    }
                }
            }
        }
        stage('Approve infrastructure changes') {
            when { expression { params.APPLY } }
            steps {
                sh(label: 'Display the exact planned changes', script: '''#!/bin/sh
set -eu
tofu -chdir=tofu/environments/kubernetes show -no-color "${WORKSPACE}/.review-tmp/kubernetes-${BUILD_NUMBER}.tfplan"
''')
                input message: "Review the exact OpenTofu plan above. RECREATE_NODE=${params.RECREATE_NODE}. When a node is selected, Jenkins replaces only that VM, temporarily clears its Proxmox protection, and restores protection after the replacement. The selected node is unavailable during replacement; wait for it to return healthy before starting another node. Other VMs remain running. Talos installation/configuration and Kubernetes workload draining are separate steps.", ok: 'Apply reviewed plan'
            }
        }
        stage('Apply approved plan') {
            when { expression { params.APPLY } }
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'infisical-homelab-prod-read-api', usernameVariable: 'INFISICAL_READ_CLIENT_ID', passwordVariable: 'INFISICAL_READ_CLIENT_SECRET'),
                    string(credentialsId: 'homelab-infisical-url', variable: 'INFISICAL_URL'),
                    string(credentialsId: 'homelab-infisical-project-id', variable: 'INFISICAL_PROJECT_ID'),
                    string(credentialsId: 'homelab-infisical-environment', variable: 'INFISICAL_ENVIRONMENT')
                ]) {
                    withEnv([
                        "PROXMOX_API_HOSTNAME=${params.PROXMOX_API_HOSTNAME}",
                        "HOMELAB_KUBERNETES_TFVARS=${env.WORKSPACE}/.review-tmp/cluster.tfvars",
                        'TOFU_ACTION=apply',
                        "RECREATE_NODE=${params.RECREATE_NODE}",
                        "TOFU_PLAN_FILE=${env.WORKSPACE}/.review-tmp/kubernetes-${env.BUILD_NUMBER}.tfplan"
                    ]) {
                        sh(label: 'Apply approved OpenTofu plan', script: '''#!/bin/sh
set +x
python3 jenkins/pipelines/kubernetes-infra/run-tofu.py
''')
                    }
                }
            }
        }
    }
    post {
        always {
            sh(label: 'Remove temporary configuration and plan', script: '''#!/bin/sh
rm -f -- "$WORKSPACE/.review-tmp/cluster.tfvars" "$WORKSPACE/.review-tmp/kubernetes-$BUILD_NUMBER.tfplan"
''')
        }
    }
}
